user_study/ui/data/demo.sqlite3*
user_study/ui/browser-acceptance/
user_study/ui/.tools/
user_study/ui/.artifacts/
user_study/ui/.study-secrets.env
user_study/ui/study-manifest.json

# Local scratch/output directories used during ad-hoc runs
.tmp/
tmp/
