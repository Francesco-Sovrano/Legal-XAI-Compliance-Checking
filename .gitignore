*~

# SQLite transient files only.
# Do NOT ignore *.sqlite3: user_study/data/public-review.sqlite3 is a
# versioned study artifact required for the bundled analyses.
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal

